---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Jasa Pembuatan Website Profesional - JalaninWeb", 
  description = "Membantu UMKM dan bisnis memiliki website modern, cepat, dan terpercaya.",
  image = "/assets/images/Techco_page_thumbnail.webp"
} = Astro.props;

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link rel="icon" type="image/svg+xml" href="/assets/images/site_logo/favourite_icon_2.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Global CSS (Legacy Support from public/assets/css/) -->
    <link rel="stylesheet" type="text/css" href="/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/fontawesome.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/animate.min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/swiper-bundle.min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/magnific-popup.min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/odometer.min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/style.css" />
  </head>
  <body>
    <div class="page_wrapper" style="overflow-x: hidden;">
      <Header />
      <slot />
      <Footer />
    </div>

    <!-- Legacy Scripts (is:inline diperlukan karena dependensi variabel global) -->
    <script is:inline src="/assets/js/jquery.min.js"></script>
    <script is:inline src="/assets/js/popper.min.js"></script>
    <script is:inline src="/assets/js/bootstrap.min.js"></script>
    <script is:inline src="/assets/js/bootstrap-dropdown-ml-hack.min.js"></script>

    <!-- Plugin Scripts -->
    <script is:inline src="/assets/js/swiper-bundle.min.js"></script>
    <script is:inline src="/assets/js/parallaxie.js"></script>
    <script is:inline src="/assets/js/parallax-scroll.js"></script>
    <script is:inline src="/assets/js/wow.min.js"></script>
    <script is:inline src="/assets/js/countdown.js"></script>
    <script is:inline src="/assets/js/magnific-popup.min.js"></script>
    <script is:inline src="/assets/js/appear.min.js"></script>
    <script is:inline src="/assets/js/odometer.min.js"></script>
    <script is:inline src="/assets/js/circularProgressBar.min.js"></script>

    <!-- Main Logic - Diletakkan paling akhir agar DOM sudah siap -->
    <script is:inline src="/assets/js/main.js"></script>
  </body>
</html>