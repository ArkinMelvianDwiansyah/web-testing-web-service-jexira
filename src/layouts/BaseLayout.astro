---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';    // untuk blog pakai 'article'
  canonical?: string;               // override canonical jika perlu
  noindex?: boolean;                // true untuk halaman yang tidak perlu diindex
}

const {
  title = "Jasa Pembuatan Website Profesional - JalaninWeb",
  description = "Membantu UMKM dan bisnis memiliki website modern, cepat, dan terpercaya.",
  image = "/assets/images/Techco_page_thumbnail.webp",
  type = "website",
  canonical,
  noindex = false,
} = Astro.props;

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const siteUrl   = "https://www.jalaninweb.com";
const pageUrl   = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const imageUrl  = new URL(image, siteUrl).href;

// Schema JSON-LD — LocalBusiness (muncul di Google Knowledge Panel)
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": `${siteUrl}/#business`,
      "name": "JalaninWeb",
      "description": "Jasa pembuatan website profesional untuk UMKM dan bisnis di Surabaya.",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/assets/images/site_logo/favourite_icon_2.svg`
      },
      "image": imageUrl,
      "telephone": "+6289680551957",
      "email": "Jalaninweb@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Rodah Sekolahan No. 21",
        "addressLocality": "Sukolilo, Surabaya",
        "addressRegion": "Jawa Timur",
        "postalCode": "60111",
        "addressCountry": "ID"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
          "opens": "08:00",
          "closes": "21:00"
        }
      ],
      "sameAs": [
        "https://wa.me/6289680551957"
      ],
      "priceRange": "Rp"
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "JalaninWeb",
      "description": "Jasa Pembuatan Website Profesional untuk UMKM dan Bisnis",
      "publisher": { "@id": `${siteUrl}/#business` }
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${siteUrl}/#website` }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link rel="icon" type="image/svg+xml" href="/assets/images/site_logo/favourite_icon_2.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- ── Primary Meta ── -->
    <title>{title}</title>
    <meta name="title"       content={title} />
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    }

    <!-- ── Canonical ── -->
    <link rel="canonical" href={pageUrl} />

    <!-- ── Open Graph ── -->
    <meta property="og:type"        content={type} />
    <meta property="og:url"         content={pageUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={imageUrl} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name"   content="JalaninWeb" />
    <meta property="og:locale"      content="id_ID" />

    <!-- ── Twitter / X Card ── -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:url"         content={pageUrl} />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={imageUrl} />

    <!-- ── Schema JSON-LD ── -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- ── Global CSS ── -->
    <link rel="stylesheet" type="text/css" href="/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/fontawesome.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/animate.min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/swiper-bundle.min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/magnific-popup.min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/odometer.min.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/style.css" />
  </head>
  <body>
    <div class="page_wrapper" style="overflow-x: hidden;">
      <Header />
      <slot />
      <Footer />
    </div>

    <!-- Legacy Scripts -->
    <script is:inline src="/assets/js/jquery.min.js"></script>
    <script is:inline src="/assets/js/popper.min.js"></script>
    <script is:inline src="/assets/js/bootstrap.min.js"></script>
    <script is:inline src="/assets/js/bootstrap-dropdown-ml-hack.min.js"></script>
    <script is:inline src="/assets/js/swiper-bundle.min.js"></script>
    <script is:inline src="/assets/js/parallaxie.js"></script>
    <script is:inline src="/assets/js/parallax-scroll.js"></script>
    <script is:inline src="/assets/js/wow.min.js"></script>
    <script is:inline src="/assets/js/countdown.js"></script>
    <script is:inline src="/assets/js/magnific-popup.min.js"></script>
    <script is:inline src="/assets/js/appear.min.js"></script>
    <script is:inline src="/assets/js/odometer.min.js"></script>
    <script is:inline src="/assets/js/circularProgressBar.min.js"></script>
    <script is:inline src="/assets/js/main.js"></script>
  </body>
</html>