---
---
<footer class="site_footer footer_layout_1">
  <div class="content_box" style="background-image: url('/assets/images/shapes/bg_pattern_3.svg');">
    <div class="container">
      <div class="diract_contact_links text-white">
        <div class="iconbox_block layout_icon_left">
          <div class="iconbox_icon">
            <img src="/assets/images/icons/icon_mail.svg" alt="Mail SVG Icon">
          </div>
          <div class="iconbox_content">
            <h3 class="iconbox_title">Email Kami</h3>
            <p class="mb-0">Jalaninweb@gmail.com</p>
          </div>
        </div>
        <div class="iconbox_block layout_icon_left">
          <div class="iconbox_icon">
            <img src="/assets/images/icons/icon_calling.svg" alt="Calling Check SVG Icon">
          </div>
          <div class="iconbox_content">
            <h3 class="iconbox_title">WhatsApp Kami</h3>
            <p class="mb-0">+(62) 89680551957</p>
          </div>
        </div>
        <div class="iconbox_block layout_icon_left">
          <div class="iconbox_icon">
            <img src="/assets/images/icons/icon_map_mark.svg" alt="Map Mark Check SVG Icon">
          </div>
          <div class="iconbox_content">
            <h3 class="iconbox_title">Lokasi Kami</h3>
            <p class="mb-0">Gebang, Surabaya, Indonesia</p>
          </div>
        </div>
      </div>

      <div class="footer_main_content">
        <div class="row justify-content-lg-between">

          <!-- Newsletter -->
          <div class="col-lg-3 col-md-6">
            <div class="footer_widget pe-md-3">
              <h2 class="footer_info_title">Newsletter</h2>
              <p>
                Daftar ke newsletter JalaninWeb untuk tips website, update layanan, dan promo terbaru.
              </p>
              <form class="footer_newslatter" action="#">
                <label for="footer_mail_input">
                  <img src="/assets/images/icons/icon_mail_2.svg" alt="Mail SVG Icon">
                </label>
                <input id="footer_mail_input" type="email" name="email" placeholder="Masukkan email kamu">
                <button type="submit"><i class="fa-solid fa-paper-plane"></i></button>
              </form>
              <ul class="social_links_block unordered_list">
                <li><a href="#!">Instagram</a></li>
                <li><a href="#!">WhatsApp</a></li>
                <li><a href="#!">TikTok</a></li>
              </ul>
            </div>
          </div>

          <!-- Layanan -->
          <div class="col-lg-3 col-md-6 col-sm-6">
            <div class="footer_widget">
              <h3 class="footer_info_title">Layanan Kami</h3>
              <ul class="icon_list unordered_list_block">
                <li>
                  <a href="/service/company-profile">
                    <span class="icon_list_text">Company Profile</span>
                  </a>
                </li>
                <li>
                  <a href="/service/landing-page">
                    <span class="icon_list_text">Landing Page</span>
                  </a>
                </li>
                <li>
                  <a href="/service/website-umkm">
                    <span class="icon_list_text">Website UMKM</span>
                  </a>
                </li>
                <li>
                  <a href="/service/toko-online">
                    <span class="icon_list_text">Toko Online</span>
                  </a>
                </li>
                <li>
                  <a href="/service/portofolio-online">
                    <span class="icon_list_text">Portofolio Online</span>
                  </a>
                </li>
                <li>
                  <a href="/service/maintenance">
                    <span class="icon_list_text">Maintenance & Support</span>
                  </a>
                </li>
                <li>
                  <a href="/service/redesign-website">
                    <span class="icon_list_text">Redesign Website</span>
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <!-- Informasi -->
          <div class="col-lg-2 col-md-6 col-sm-6">
            <div class="footer_widget">
              <h3 class="footer_info_title">Informasi</h3>
              <ul class="icon_list unordered_list_block">
                <li>
                  <a href="/about">
                    <span class="icon_list_text">Tentang JalaninWeb</span>
                  </a>
                </li>
                <li>
                  <a href="/pricing">
                    <span class="icon_list_text">Harga & Paket</span>
                  </a>
                </li>
                <li>
                  <a href="/portfolio">
                    <span class="icon_list_text">Portfolio Klien</span>
                  </a>
                </li>
                <li>
                  <a href="/blog">
                    <span class="icon_list_text">Blog & Tips</span>
                  </a>
                </li>
                <li>
                  <a href="/faq">
                    <span class="icon_list_text">FAQ</span>
                  </a>
                </li>
                <li>
                  <a href="/contact">
                    <span class="icon_list_text">Kontak Kami</span>
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <!-- Kenapa Kami -->
          <div class="col-lg-2 col-md-6 col-sm-6">
            <div class="footer_widget">
              <h3 class="footer_info_title">Kenapa Kami</h3>
              <ul class="icon_list unordered_list_block">
                <li>
                  <a href="/about#proses">
                    <span class="icon_list_text">Pengerjaan Cepat</span>
                  </a>
                </li>
                <li>
                  <a href="/about#harga">
                    <span class="icon_list_text">Harga Terjangkau</span>
                  </a>
                </li>
                <li>
                  <a href="/about#revisi">
                    <span class="icon_list_text">Revisi Gratis</span>
                  </a>
                </li>
                <li>
                  <a href="/about#support">
                    <span class="icon_list_text">Support Responsif</span>
                  </a>
                </li>
                <li>
                  <a href="/about#teknologi">
                    <span class="icon_list_text">Teknologi Modern</span>
                  </a>
                </li>
                <li>
                  <a href="/portfolio">
                    <span class="icon_list_text">99+ Klien Puas</span>
                  </a>
                </li>
              </ul>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <div class="footer_bottom">
    <div class="container d-md-flex align-items-md-center justify-content-md-between">
      <p class="copyright_text m-0">
        Copyright © 2026 JalaninWeb. All rights reserved.
      </p>
      <p class="copyright_text m-0">
        Designed & Developed by <b>JalaninWeb</b>
      </p>
    </div>
  </div>
</footer>