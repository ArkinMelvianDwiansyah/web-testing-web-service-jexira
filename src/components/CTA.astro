---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
}

const {
  title = "Siap Memiliki Website Profesional untuk Bisnis Anda?",
  description = "Konsultasikan kebutuhan website Anda sekarang. Gratis, tanpa komitmen, dan kami bantu dari perencanaan hingga website siap digunakan.",
  buttonText = "Konsultasi Gratis Sekarang",
  buttonLink = "/contact"
} = Astro.props;
---

<section class="calltoaction_section parallaxie" style="background-image: url('/assets/images/backgrounds/bg_image_1.webp');">
  <div class="container text-center">
    <div class="heading_block text-white">
      <h3 class="heading_text" style="font-size: 40px;">{title}</h3>
      <p class="heading_description mb-0">{description}</p>
    </div>
    <a class="btn btn-primary" href={buttonLink}>
      <span class="btn_label" data-text={buttonText}>{buttonText}</span>
      <span class="btn_icon"><i class="fa-solid fa-arrow-up-right"></i></span>
    </a>
  </div>
</section>