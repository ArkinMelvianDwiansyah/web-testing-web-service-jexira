---
// src/components/WhatsAppCTA.astro
interface Props {
  phone?: string;
  message?: string;
}

const {
  phone = "6289680551957",
  message = "Halo JalaninWeb, saya tertarik untuk konsultasi pembuatan website."
} = Astro.props;

const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<!-- WhatsApp CTA Button - Start -->
<div class="wa_cta" id="wa-cta">
  <!-- Popup bubble -->
  <div class="wa_cta_bubble" id="wa-bubble">
    <button class="wa_cta_bubble_close" id="wa-bubble-close" aria-label="Tutup">×</button>
    <p>Ada yang bisa dibantu? Langsung chat aja yuk! 😊</p>
  </div>
  <!-- Button -->
  <a href={waUrl} target="_blank" rel="noopener noreferrer" aria-label="Chat WhatsApp" class="wa_cta_btn">
    <i class="fa-brands fa-whatsapp"></i>
  </a>
</div>
<!-- WhatsApp CTA Button - End -->

<style>
  .wa_cta {
    position: fixed;
    bottom: 160px;
    right: 15px;
    z-index: 998;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    width: auto;
    max-width: 280px;
    pointer-events: none;
  }

  .wa_cta_btn,
  .wa_cta_bubble {
    pointer-events: auto;
  }

  .wa_cta_btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #25D366;
    color: #ffffff;
    font-size: 30px;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    animation: wa_pulse 2s infinite;
  }

  .wa_cta_btn:hover {
    transform: scale(1.15);
    box-shadow: 0 8px 28px rgba(37, 211, 102, 0.55);
    color: #ffffff;
  }

  @keyframes wa_pulse {
    0%, 100% { box-shadow: 0 4px 14px rgba(37, 211, 102, 0.4); }
    50% { box-shadow: 0 4px 24px rgba(37, 211, 102, 0.7); }
  }

  /* Popup bubble */
  .wa_cta_bubble {
    background: #ffffff;
    border-radius: 12px;
    padding: 14px 18px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    max-width: 220px;
    position: relative;
    opacity: 0;
    transform: translateY(10px) scale(0.9);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .wa_cta_bubble.show {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .wa_cta_bubble p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: #333;
  }

  .wa_cta_bubble::after {
    content: '';
    position: absolute;
    bottom: -6px;
    right: 24px;
    width: 12px;
    height: 12px;
    background: #ffffff;
    transform: rotate(45deg);
    box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.05);
  }

  .wa_cta_bubble_close {
    position: absolute;
    top: 4px;
    right: 8px;
    background: none;
    border: none;
    font-size: 18px;
    color: #999;
    cursor: pointer;
    line-height: 1;
    padding: 0;
  }

  .wa_cta_bubble_close:hover {
    color: #333;
  }
</style>

<script is:inline>
  (function() {
    var bubble = document.getElementById('wa-bubble');
    var closeBtn = document.getElementById('wa-bubble-close');

    // Show bubble after 5 seconds
    setTimeout(function() {
      if (bubble) bubble.classList.add('show');
    }, 5000);

    // Close bubble on click
    if (closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        bubble.classList.remove('show');
      });
    }
  })();
</script>
