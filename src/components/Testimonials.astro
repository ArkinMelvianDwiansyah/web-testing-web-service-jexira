---
interface Props {
  title?: string;
  badgeHighlight?: string;
}

const {
  title = "Apa Kata Klien Tentang Kami",
  badgeHighlight = "Klien"
} = Astro.props;

const reviews = [
  {
    comment: "Website yang dibuat sangat profesional dan mudah digunakan. Setelah website live, pelanggan jadi lebih percaya dan mudah menghubungi kami.",
    name: "Andi Simatupang",
    role: "Owner Coffee Shop",
    image: "/assets/images/avatar/avatar_4.webp"
  },
  {
    comment: "Portofolio online saya jadi terlihat lebih profesional. Sangat membantu untuk melamar pekerjaan dan mendapatkan klien baru.",
    name: "Raden Wahyu",
    role: "UI/UX Designer",
    image: "/assets/images/avatar/avatar_5.webp"
  },
  {
    comment: "Prosesnya cepat, komunikatif, dan hasilnya sesuai ekspektasi. Tim sangat membantu dari awal sampai launching.",
    name: "Rina Putri",
    role: "Manager CV Semoga Rezeki",
    image: "/assets/images/avatar/avatar_6.webp"
  },
  {
    comment: "Sebelumnya kami hanya mengandalkan pemasaran offline. Setelah memiliki website, calon pelanggan jadi lebih mudah melihat produk dan menghubungi kami.",
    name: "Budi Santoso",
    role: "Owner Pabrik Furniture",
    image: "/assets/images/avatar/avatar_7.webp"
  },
  {
    comment: "Hasil desainnya melebihi ekspektasi kami. Tampilan modern dan responsif di semua perangkat. Klien kami pun banyak yang memuji tampilan website-nya.",
    name: "Sari Dewi",
    role: "Direktur PT Maju Bersama",
    image: "/assets/images/avatar/avatar_8.webp"
  },
  {
    comment: "Pengerjaan tepat waktu dan sesuai brief yang kami berikan. Komunikasi sangat lancar dan revisi ditangani dengan cepat. Sangat rekomendasikan!",
    name: "Hendra Kusuma",
    role: "Founder Startup Teknologi",
    image: "/assets/images/avatar/avatar_9.webp"
  }
];
---

<section class="review_section section_space" style="background-image: url('/assets/images/shapes/bg_pattern_2.svg');">
  <div class="container">
    <div class="heading_block text-center">
      <div class="heading_focus_text">
        Testimoni 
        <span class="badge bg-secondary text-white">{badgeHighlight}</span> 
      </div>
      <h2 class="heading_text mb-0">
        {title}
      </h2>
    </div>

    <!-- Swiper Carousel -->
    <div class="swiper testi_carousel">
      <div class="swiper-wrapper">
        {reviews.map((review) => (
          <div class="swiper-slide">
            <div class="review_block_3">
              <div class="quote_icon">
                <i class="fa-solid fa-quote-left"></i>
              </div>
              <p class="review_commtent">{review.comment}</p>
              <div class="review_admin">
                <div class="review_admin_image">
                  <img src={review.image} alt={review.name} loading="lazy" />
                </div>
                <div class="review_admin_info">
                  <h4 class="review_admin_name">{review.name}</h4>
                  <span class="review_admin_designation">{review.role}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="swiper-pagination testi_pagination"></div>
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof Swiper !== 'undefined') {
      new Swiper('.testi_carousel', {
        slidesPerView: 1.2,
        spaceBetween: 16,
        grabCursor: true,
        pagination: {
          el: '.testi_pagination',
          clickable: true
        },
        breakpoints: {
          576: {
            slidesPerView: 2,
            spaceBetween: 20
          },
          992: {
            slidesPerView: 3,
            spaceBetween: 24
          }
        }
      });
    }
  });
</script>

<style>
  /* Card */
  .review_block_3 {
    height: 100%;
    min-height: 240px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: #ffffff;
    border-radius: 14px;
    padding: 28px;
    border: 1.5px solid rgba(0, 68, 235, 0.10);
    box-shadow:
      0 4px 12px rgba(2, 8, 66, 0.08),
      0 12px 28px rgba(2, 8, 66, 0.12),
      0 24px 48px rgba(2, 8, 66, 0.06);
    cursor: default;
    position: relative;
    overflow: hidden;
  }

  /* Quote icon */
  .review_block_3 .quote_icon {
    font-size: 28px;
    line-height: 1;
    margin-bottom: 4px;
    color: rgba(0, 68, 235, 0.20);
    display: inline-block;
  }

  /* Comment text — fixed height agar semua card sama */
  .review_block_3 .review_commtent {
    flex: none;
    height: 96px;
    margin-top: 14px !important;
    margin-bottom: 20px !important;
    font-size: 14.5px;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Author section — foto dan nama bersebelahan */
  .review_block_3 .review_admin {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    margin-top: auto;
  }

  .review_block_3 .review_admin_image {
    width: 36px;
    height: 36px;
    min-width: 36px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 50%;
  }

  .review_block_3 .review_admin_image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review_block_3 .review_admin_info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .review_block_3 .review_admin_name {
    font-size: 13px;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .review_block_3 .review_admin_designation {
    font-size: 11px;
    color: #6c757d;
    line-height: 1.3;
  }

  /* Swiper slides same height */
  .testi_carousel .swiper-wrapper {
    align-items: stretch;
  }

  .testi_carousel .swiper-slide {
    height: auto;
  }

  /* Pagination dots */
  .testi_pagination {
    margin-top: 24px;
    text-align: center;
  }

  /* Mobile: card compact */
  @media (max-width: 767px) {
    .review_block_3 {
      padding: 18px;
      border-radius: 10px;
      min-height: 200px;
    }

    .review_block_3 .quote_icon {
      font-size: 20px;
    }

    .review_block_3 .review_commtent {
      font-size: 12.5px;
      line-height: 1.5;
      height: 75px;
      margin-top: 10px !important;
      margin-bottom: 14px !important;
    }

    .review_block_3 .review_admin_image {
      width: 32px;
      height: 32px;
      min-width: 32px;
    }

    .review_block_3 .review_admin_name {
      font-size: 12px;
      margin-bottom: 0;
    }

    .review_block_3 .review_admin_designation {
      font-size: 10px;
    }
  }
</style>
