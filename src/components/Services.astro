---
// src/components/Services.astro
import { services } from '../data/services';

interface Props {
  badgePrefix?: string;
  badgeHighlight?: string;
  title?: string;
  limit?: number; // berapa service yang ditampilkan, default semua
}

const {
  badgePrefix = "Layanan",
  badgeHighlight = "Kami",
  title = "Solusi Website untuk Berbagai Kebutuhan",
  limit,
} = Astro.props;

// Data langsung dari services.ts agar konsisten
const serviceList = [
  { slug: 'company-profile', image: '/assets/images/services/service_image_1.webp', alt: 'Website Company Profile',  tags: ['Bisnis', 'Corporate', 'UMKM'],      col: 'col-lg-6' },
  { slug: 'website-umkm',    image: '/assets/images/services/service_image_2.webp', alt: 'Website UMKM',            tags: ['Katalog', 'Produk', 'Promosi'],      col: 'col-lg-6' },
  { slug: 'portofolio-online',image: '/assets/images/services/service_image_3.webp',alt: 'Website Portofolio',      tags: ['Mahasiswa', 'Freelancer'],           col: 'col-lg-4' },
  { slug: 'landing-page',    image: '/assets/images/services/service_image_4.webp', alt: 'Landing Page Bisnis',     tags: ['Event', 'Campaign', 'Produk'],       col: 'col-lg-4' },
  { slug: 'maintenance',     image: '/assets/images/services/service_image_5.webp', alt: 'Maintenance & Support',   tags: ['Update', 'Backup', 'Support'],       col: 'col-lg-4' },
  { slug: 'toko-online',     image: '/assets/images/services/service_image_6.webp', alt: 'Toko Online',             tags: ['E-Commerce', 'Produk', 'Checkout'],  col: 'col-lg-6' },
  { slug: 'redesign-website',  image: '/assets/images/services/service_image_7.webp', alt: 'Redesign Website',        tags: ['Revamp', 'Modern', 'Migrasi'],     col: 'col-lg-6' },
];

// Import title dari data agar konsisten dengan halaman detail
const enriched = serviceList
  .map(s => ({
    ...s,
    title: services.find(d => d.slug === s.slug)?.title ?? s.alt,
  }))
  .slice(0, limit ?? serviceList.length);
---

<section class="service_section section_space xb-hidden pb-5">
  <div class="container">
    <div class="heading_block text-center">
      <div class="heading_focus_text">
        {badgePrefix}
        <span class="badge bg-secondary text-white">{badgeHighlight}</span>
      </div>
      <h2 class="heading_text mb-0">{title}</h2>
    </div>

    <div class="row">
      {enriched.map((s) => (
        <div class={s.col}>
          <div class="service_block">
            <div class="service_image">
              <img src={s.image} alt={s.alt} loading="lazy" />
            </div>
            <div class="service_content">
              <h3 class="service_title">
                <a href={`/service/${s.slug}`}>{s.title}</a>
              </h3>
              <div class="links_wrapper">
                <ul class="category_btns_group unordered_list">
                  {s.tags.map(tag => (
                    <li><a href="#!">{tag}</a></li>
                  ))}
                </ul>
                <a class="icon_block" href={`/service/${s.slug}`}>
                  <i class="fa-regular fa-arrow-up-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="btns_group pb-0">
      <a class="btn btn-outline-light" href="/services">
        <span class="btn_label" data-text="Semua Layanan">Semua Layanan</span>
        <span class="btn_icon">
          <i class="fa-solid fa-arrow-up-right"></i>
        </span>
      </a>
    </div>
  </div>
</section>