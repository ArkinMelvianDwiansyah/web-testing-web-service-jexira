---
// src/components/Services.astro
import { services } from '../data/services';

interface Props {
  badgePrefix?: string;
  badgeHighlight?: string;
  title?: string;
  limit?: number; // berapa service yang ditampilkan, default semua
}

const {
  badgePrefix = "Layanan",
  badgeHighlight = "Kami",
  title = "Solusi Website untuk Berbagai Kebutuhan",
  limit,
} = Astro.props;

// Langsung potong array sesuai limit jika ada
const displayedServices = services.slice(0, limit ?? services.length);
---

<section class="service_section section_space xb-hidden pb-5">
  <div class="container">
    <div class="heading_block text-center">
      <div class="heading_focus_text">
        {badgePrefix}
        <span class="badge bg-secondary text-white">{badgeHighlight}</span>
      </div>
      <h2 class="heading_text mb-0">{title}</h2>
    </div>

    <div class="row">
      {displayedServices.map((s) => (
        <div class={s.gridCol}>
          <div class="service_block">
            <div class="service_image">
              <img src={s.listImage} alt={s.title} loading="lazy" />
            </div>
            <div class="service_content">
              <h3 class="service_title">
                <a href={`/service/${s.slug}`}>{s.title}</a>
              </h3>
              <div class="links_wrapper">
                <ul class="category_btns_group unordered_list">
                  {s.tags.map(tag => (
                    <li><a href="#!">{tag}</a></li>
                  ))}
                </ul>
                <a class="icon_block" href={`/service/${s.slug}`}>
                  <i class="fa-regular fa-arrow-up-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="btns_group pb-0">
      <a class="btn btn-outline-light" href="/services">
        <span class="btn_label" data-text="Semua Layanan">Semua Layanan</span>
        <span class="btn_icon">
          <i class="fa-solid fa-arrow-up-right"></i>
        </span>
      </a>
    </div>
  </div>
</section>