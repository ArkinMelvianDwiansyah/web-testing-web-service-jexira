---
// src/components/FaqAccordion.astro
import { faqCategories } from "../data/faq";
---

<section class="faq_section section_space">
  <div class="container">
    <div class="row justify-content-lg-between">
      <!-- Sidebar Kiri -->
      <div class="col-lg-3 col-md-12">
        <div class="faq_sidebar">
          <ul class="faq_tab_list">
            {
              faqCategories.map((cat, i) => (
                <li>
                  <button
                    class:list={["faq_tab_btn", { active: i === 0 }]}
                    data-target={`faq_cat_${cat.id}`}
                    type="button"
                  >
                    <span class="faq_tab_icon">
                      <i class={cat.icon} />
                    </span>
                    <span class="faq_tab_text">
                      <strong>{cat.label}</strong>
                      <small>{cat.items.length} pertanyaan</small>
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>

          <a
            href="https://wa.me/6289680551957"
            target="_blank"
            rel="noopener"
            class="faq_wa_cta"
          >
            <span class="faq_wa_icon">
              <i class="fa-brands fa-whatsapp"></i>
            </span>
            <span class="faq_wa_text">
              <strong>Masih bingung?</strong>
              <small>Chat langsung via WhatsApp</small>
            </span>
          </a>
        </div>
      </div>

      <!-- Konten Kanan -->
      <div class="col-lg-8 col-md-12">
        {
          faqCategories.map((cat, catIdx) => (
            <div
              class:list={["faq_panel", { "faq_panel--active": catIdx === 0 }]}
              id={`faq_cat_${cat.id}`}
            >
              <div class="faq_panel_heading">
                <i class={cat.icon} />
                <span>{cat.label}</span>
                <small>— {cat.items.length} pertanyaan</small>
              </div>

              <div class="accordion" id={`accordion_${cat.id}`}>
                {cat.items.map((item, itemIdx) => {
                  const collapseId = `collapse_${cat.id}_${itemIdx}`;
                  const isFirst = itemIdx === 0 && catIdx === 0;
                  return (
                    <div class="accordion-item">
                      <h2 class="accordion-header">
                        <button
                          class:list={[
                            "accordion-button",
                            { collapsed: !isFirst },
                          ]}
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target={`#${collapseId}`}
                          aria-expanded={isFirst ? "true" : "false"}
                          aria-controls={collapseId}
                        >
                          {item.question}
                        </button>
                      </h2>
                      <div
                        id={collapseId}
                        class:list={[
                          "accordion-collapse collapse",
                          { show: isFirst },
                        ]}
                        data-bs-parent={`#accordion_${cat.id}`}
                      >
                        <div class="accordion-body">
                          <p class="mb-0">{item.answer}</p>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <style>
    /* ── Exclude FontAwesome dari font inherit ── */
    .faq_section
      *:not(.fa):not(.fas):not(.far):not(.fab):not(.fal):not(.fad):not(
        [class*="fa-"]
      ) {
      font-family: inherit;
    }

    /* ── SECTION ── */
    .faq_section {
      background: #f8f9fc;
    }

    /* ── SIDEBAR ── */
    .faq_sidebar {
      position: sticky;
      top: 100px;
    }

    .faq_tab_list {
      list-style: none;
      padding: 0;
      margin: 0 0 24px 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .faq_tab_btn {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: #fff;
      border: 1.5px solid #e5e7eb;
      border-radius: 12px;
      cursor: pointer;
      text-align: left;
      transition: all 0.22s ease;
    }

    .faq_tab_btn:hover {
      border-color: var(--color-primary, #1b3bbb);
      background: #f0f4ff;
    }

    .faq_tab_btn.active {
      background: var(--color-primary, #1b3bbb);
      border-color: var(--color-primary, #1b3bbb);
      color: #fff;
    }

    .faq_tab_icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: rgba(27, 59, 187, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 14px;
      color: var(--color-primary, #1b3bbb);
      transition: all 0.22s ease;
    }

    .faq_tab_btn.active .faq_tab_icon {
      background: rgba(255, 255, 255, 0.2);
      color: #fff;
    }

    .faq_tab_text {
      display: flex;
      flex-direction: column;
      gap: 1px;
    }

    .faq_tab_text strong {
      font-size: 14px;
      font-weight: 700;
      line-height: 1.3;
    }

    .faq_tab_text small {
      font-size: 11px;
      opacity: 0.65;
    }

    /* WhatsApp CTA */
    .faq_wa_cta {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px;
      background: #25d366;
      border-radius: 12px;
      text-decoration: none;
      color: #fff;
      transition: opacity 0.2s ease;
    }

    .faq_wa_cta:hover {
      opacity: 0.9;
      color: #fff;
    }

    .faq_wa_icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }

    .faq_wa_text {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .faq_wa_text strong {
      font-size: 14px;
      font-weight: 700;
      line-height: 1.3;
    }

    .faq_wa_text small {
      font-size: 11px;
      opacity: 0.85;
    }

    /* ── PANEL KANAN ── */
    .faq_panel {
      display: none;
    }

    .faq_panel--active {
      display: block;
    }

    .faq_panel_heading {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 18px;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 2px solid #e5e7eb;
    }

    .faq_panel_heading i {
      color: var(--color-primary, #1b3bbb);
      font-size: 18px;
    }

    .faq_panel_heading small {
      font-size: 13px;
      font-weight: 400;
      color: #9ca3af;
      margin-left: auto;
    }

    /* ── ACCORDION ── */
    .accordion-item {
      border: 1.5px solid #e5e7eb;
      border-radius: 10px !important;
      margin-bottom: 10px;
      overflow: hidden;
    }

    .accordion-button {
      font-weight: 700;
      font-size: 15px;
      padding: 18px 20px;
      background: #fff;
      color: #0f172a;
    }

    .accordion-button:not(.collapsed) {
      background: #f0f4ff;
      color: var(--color-primary, #1b3bbb);
      box-shadow: none;
    }

    .accordion-button::after {
      filter: none;
    }

    .accordion-button:not(.collapsed)::after {
      filter: invert(28%) sepia(98%) saturate(800%) hue-rotate(210deg);
    }

    .accordion-body {
      padding: 4px 20px 20px;
      font-size: 15px;
      line-height: 1.75;
      color: #4b5563;
      background: #fff;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 991px) {
      .faq_sidebar {
        position: static;
        margin-bottom: 40px;
      }

      .faq_tab_list {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 8px;
      }

      .faq_tab_btn {
        width: auto;
        padding: 8px 14px;
        border-radius: 999px;
        gap: 8px;
      }

      .faq_tab_icon {
        width: 28px;
        height: 28px;
        font-size: 12px;
      }

      .faq_tab_text strong {
        font-size: 13px;
      }

      .faq_tab_text small {
        display: none;
      }
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const btns = document.querySelectorAll<HTMLButtonElement>(".faq_tab_btn");
      const panels = document.querySelectorAll<HTMLElement>(".faq_panel");

      btns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.dataset.target!;
          btns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          panels.forEach((p) => p.classList.remove("faq_panel--active"));
          document.getElementById(target)?.classList.add("faq_panel--active");
        });
      });
    });
  </script>
</section>
