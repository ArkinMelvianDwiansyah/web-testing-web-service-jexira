---
// src/components/PortfolioGrid.astro
import { portfolios } from '../data/portfolio';
import { services } from '../data/services';

// Icon mapping per service slug
const iconMap: Record<string, string> = {
  'company-profile': 'fa-solid fa-building',
  'website-umkm-katalog': 'fa-solid fa-store',
  'portofolio-online': 'fa-solid fa-palette',
  'landing-page': 'fa-solid fa-rocket',
  'maintenance': 'fa-solid fa-wrench',
  'undangan-online': 'fa-solid fa-envelope-open-text',
  'redesign-website': 'fa-solid fa-wand-magic-sparkles',
  'web-scraping': 'fa-solid fa-database',
};
---

<section class="portfolio_section section_space bg-light">
  <div class="container">

    <!-- Filter Navigation -->
    <div class="pf_filter_nav">
      <button class="pf_filter_btn active" data-filter="all" type="button">
        <span class="pf_filter_icon"><i class="fa-solid fa-border-all"></i></span>
        <span class="pf_filter_label">Semua</span>
      </button>
      {services.map((service) => (
        <button class="pf_filter_btn" data-filter={service.slug} type="button">
          <span class="pf_filter_icon"><i class={iconMap[service.slug] || 'fa-solid fa-globe'}></i></span>
          <span class="pf_filter_label">{service.title}</span>
        </button>
      ))}
    </div>

    <!-- Portfolio Grid -->
    <div class="pf_grid">
      {portfolios.map((portfolio) => (
        <div class={`pf_grid_item ${portfolio.filter}`}>
          <a class="pf_card" href={`/portfolio/${portfolio.slug}`}>
            <div class="pf_card_img">
              <img src={portfolio.image} alt={portfolio.title} loading="lazy" />
            </div>
            <div class="pf_card_body">
              <span class="pf_card_badge">{portfolio.service}</span>
              <h3 class="pf_card_title">{portfolio.title}</h3>
              <span class="pf_card_client"><i class="fa-solid fa-user"></i> {portfolio.client}</span>
            </div>
          </a>
        </div>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var btns = document.querySelectorAll('.pf_filter_btn');
    var items = document.querySelectorAll('.pf_grid_item');
    btns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        btns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var filter = btn.getAttribute('data-filter');
        items.forEach(function(item) {
          if (filter === 'all' || item.classList.contains(filter)) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style is:global>
  /* ═══════════════════════════════════════
     FILTER NAV
  ═══════════════════════════════════════ */
  .pf_filter_nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 32px;
  }

  .pf_filter_btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: #fff;
    border: 1.5px solid #e5e7eb;
    border-radius: 12px;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }

  .pf_filter_btn:hover {
    border-color: #1b3bbb;
    background: #f0f4ff;
  }

  .pf_filter_btn.active {
    background: #1b3bbb;
    border-color: #1b3bbb;
    color: #fff;
  }

  .pf_filter_icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: rgba(27, 59, 187, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 14px;
    color: #1b3bbb;
  }

  .pf_filter_btn.active .pf_filter_icon {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
  }

  .pf_filter_label {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  /* ═══════════════════════════════════════
     PORTFOLIO GRID
  ═══════════════════════════════════════ */
  .pf_grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .pf_card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid #eaedf3;
    height: 100%;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .pf_card:hover {
    box-shadow: 0 8px 30px rgba(27, 59, 187, 0.1);
    transform: translateY(-3px);
    color: inherit;
  }

  .pf_card_img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f1f5f9;
  }

  .pf_card_img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .pf_card:hover .pf_card_img img {
    transform: scale(1.05);
  }

  .pf_card_body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .pf_card_badge {
    display: inline-block;
    background: #eef2ff;
    color: #1b3bbb;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    align-self: flex-start;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .pf_card_title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
    color: #0f172a;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pf_card_client {
    font-size: 12px;
    color: #9ca3af;
    margin-top: auto;
  }

  .pf_card_client i {
    margin-right: 4px;
    font-size: 10px;
  }

  /* ═══════════════════════════════════════
     RESPONSIVE
  ═══════════════════════════════════════ */

  /* Tablet */
  @media (max-width: 991px) {
    .pf_filter_nav {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .pf_filter_btn {
      padding: 10px 12px;
    }

    .pf_filter_label {
      font-size: 11px;
    }

    .pf_filter_icon {
      width: 28px;
      height: 28px;
      font-size: 12px;
    }

    .pf_grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  /* Mobile */
  @media (max-width: 575px) {
    .pf_filter_nav {
      grid-template-columns: repeat(2, 1fr);
      gap: 6px;
    }

    .pf_filter_btn {
      padding: 8px 10px;
      border-radius: 10px;
      gap: 8px;
    }

    .pf_filter_icon {
      width: 24px;
      height: 24px;
      font-size: 10px;
      border-radius: 6px;
    }

    .pf_filter_label {
      font-size: 10px;
    }

    .pf_grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .pf_card {
      border-radius: 10px;
    }

    .pf_card_body {
      padding: 12px;
      gap: 6px;
      text-align: left;
    }

    .pf_card_badge {
      font-size: 9px;
      padding: 3px 8px;
    }

    .pf_card_title {
      font-size: 12px;
      text-align: left;
      -webkit-line-clamp: 2;
    }

    .pf_card_client {
      font-size: 10px;
      text-align: left;
    }

    .pf_card:hover {
      transform: none;
      box-shadow: none;
    }
  }

  /* Extra small */
  @media (max-width: 399px) {
    .pf_card_body {
      padding: 10px;
    }

    .pf_card_title {
      font-size: 11px;
    }

    .pf_card_badge {
      font-size: 8.5px;
    }
  }
</style>
