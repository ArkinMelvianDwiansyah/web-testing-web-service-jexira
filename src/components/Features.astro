---
interface Props {
  badgeText?: string;
  title?: string;
  description?: string;
}

const {
  badgeText = "Kenapa Memilih Kami",
  title = "Alasan Klien Mempercayai Kami",
  description = "Kami menghadirkan solusi website profesional dengan proses yang mudah, transparan, dan sesuai kebutuhan bisnis Anda."
} = Astro.props;
---

<section class="service_section section_space bg-light">
  <div class="container">
    <div class="row align-items-center justify-content-lg-between">
      <div class="col-lg-6">
        <div class="image_wrap">
          <img src="/assets/images/about/about_image_5.webp" alt="Keunggulan Layanan Pembuatan Website JalaninWeb" loading="lazy">
        </div>
      </div>
      <div class="col-lg-6">
        <div class="ps-lg-5">
          <div class="heading_block">
            <div class="heading_focus_text">
              <span class="badge bg-secondary text-white">{badgeText}</span>
            </div>
            <h2 class="heading_text mb-0">
              {title}
            </h2>
            <p class="heading_description mt-2">{description}</p>
          </div>
          <ul class="service_facilities_group unordered_list">
            <li>
              <a class="iconbox_block layout_icon_left" href="#">
                <span class="iconbox_icon">
                  <img src="/assets/images/icons/icon_check_2.svg" alt="Icon Desain Modern" loading="lazy">
                </span>
                <span class="iconbox_content">
                  <strong class="iconbox_title mb-0">Desain Modern & Responsive</strong>
                </span>
              </a>
            </li>
            <li>
              <a class="iconbox_block layout_icon_left" href="/service-details">
                <span class="iconbox_icon">
                  <img src="/assets/images/icons/icon_leaf.svg" alt="Icon Proses Cepat" loading="lazy">
                </span>
                <span class="iconbox_content">
                  <strong class="iconbox_title mb-0">Proses Cepat & Terstruktur</strong>
                </span>
              </a>
            </li>
            <li>
              <a class="iconbox_block layout_icon_left" href="/service-details">
                <span class="iconbox_icon">
                  <img src="/assets/images/icons/icon_box.svg" alt="Icon Harga Fleksibel" loading="lazy">
                </span>
                <span class="iconbox_content">
                  <strong class="iconbox_title mb-0">Harga Fleksibel</strong>
                </span>
              </a>
            </li>
            <li>
              <a class="iconbox_block layout_icon_left" href="/service-details">
                <span class="iconbox_icon">
                  <img src="/assets/images/icons/icon_receipt_add.svg" alt="Icon Konsultasi Gratis" loading="lazy">
                </span>
                <span class="iconbox_content">
                  <strong class="iconbox_title mb-0">Konsultasi Gratis</strong>
                </span>
              </a>
            </li>
            <li>
              <a class="iconbox_block layout_icon_left" href="/service-details">
                <span class="iconbox_icon">
                  <img src="/assets/images/icons/icon_monitor.svg" alt="Icon Support dan Revisi" loading="lazy">
                </span>
                <span class="iconbox_content">
                  <strong class="iconbox_title mb-0">Support & Revisi</strong>
                </span>
              </a>
            </li>
            <li>
              <a class="iconbox_block layout_icon_left" href="/service-details">
                <span class="iconbox_icon">
                  <img src="/assets/images/icons/icon_microscope.svg" alt="Icon Siap Go Live" loading="lazy">
                </span>
                <span class="iconbox_content">
                  <strong class="iconbox_title mb-0">Siap Go Live</strong>
                </span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>