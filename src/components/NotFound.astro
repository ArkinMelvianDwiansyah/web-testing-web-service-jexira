---
// src/components/NotFound.astro
// Gunakan di src/pages/404.astro:
// import NotFound from '../components/NotFound.astro';
// <NotFound />
---

<div id="jw_404_wrap">
  <!-- Blob dekorasi -->
  <div class="jw404_blob jw404_blob_a" aria-hidden="true"></div>
  <div class="jw404_blob jw404_blob_b" aria-hidden="true"></div>

  <!-- Visual 404 -->
  <div class="jw404_visual">
    <span class="jw404_digit" style="color:#0044EB;">4</span>

    <span class="jw404_zero">
      <span class="jw404_zero_bg"></span>
      <i class="fa-solid fa-magnifying-glass jw404_icon"></i>
    </span>

    <span class="jw404_digit" style="color:#F44380;">4</span>
  </div>

  <!-- Badge -->
  <div class="jw404_badge">
    Oops!&nbsp;
    <span class="badge bg-secondary text-white">Halaman Tidak Ditemukan</span>
  </div>

  <!-- Heading & Desc -->
  <h1 class="jw404_heading">
    Sepertinya kamu nyasar ke halaman yang tidak ada
  </h1>
  <p class="jw404_desc">
    Halaman yang kamu cari mungkin sudah dipindahkan, dihapus, atau memang tidak
    pernah ada. Tapi tenang — masih banyak yang bisa kamu jelajahi di
    JalaninWeb.
  </p>

  <!-- CTA Buttons -->
  <div class="btns_group justify-content-center pb-0 jw404_cta">
    <a class="btn btn-primary" href="/">
      <span class="btn_label" data-text="Kembali ke Beranda"
        >Kembali ke Beranda</span
      >
      <span class="btn_icon"><i class="fa-solid fa-house"></i></span>
    </a>
    <a class="btn btn-outline-light" href="/contact">
      <span class="btn_label" data-text="Hubungi Kami">Hubungi Kami</span>
      <span class="btn_icon"><i class="fa-solid fa-arrow-up-right"></i></span>
    </a>
  </div>

  <!-- Divider -->
  <div class="jw404_divider">
    <span>Atau jelajahi langsung</span>
  </div>

  <!-- Quick Link Cards -->
  <div class="jw404_grid">
    <a href="/services" class="jw404_card" data-wa="false">
      <span
        class="jw404_card_ico"
        style="background:rgba(0,68,235,.1);color:#0044EB;"
      >
        <i class="fa-solid fa-layer-group"></i>
      </span>
      <span class="jw404_card_txt">
        <strong>Layanan Kami</strong>
        <small>Website, landing page, toko online</small>
      </span>
      <i class="fa-solid fa-arrow-right jw404_card_arr"></i>
    </a>

    <a href="/portfolio" class="jw404_card" data-wa="false">
      <span
        class="jw404_card_ico"
        style="background:rgba(244,67,128,.1);color:#F44380;"
      >
        <i class="fa-solid fa-briefcase"></i>
      </span>
      <span class="jw404_card_txt">
        <strong>Portfolio</strong>
        <small>Lihat hasil kerja nyata kami</small>
      </span>
      <i class="fa-solid fa-arrow-right jw404_card_arr"></i>
    </a>

    <a href="/blog" class="jw404_card" data-wa="false">
      <span
        class="jw404_card_ico"
        style="background:rgba(35,186,191,.1);color:#23BABF;"
      >
        <i class="fa-solid fa-newspaper"></i>
      </span>
      <span class="jw404_card_txt">
        <strong>Blog & Tips</strong>
        <small>Artikel seputar dunia website</small>
      </span>
      <i class="fa-solid fa-arrow-right jw404_card_arr"></i>
    </a>

    <a
      href="https://wa.me/6289680551957"
      target="_blank"
      rel="noopener"
      class="jw404_card"
      data-wa="true"
    >
      <span
        class="jw404_card_ico"
        style="background:rgba(37,211,102,.1);color:#25d366;"
      >
        <i class="fa-brands fa-whatsapp"></i>
      </span>
      <span class="jw404_card_txt">
        <strong>Chat WhatsApp</strong>
        <small>Langsung tanya ke tim kami</small>
      </span>
      <i class="fa-solid fa-arrow-right jw404_card_arr"></i>
    </a>
  </div>
</div>

<!-- ══════════════════════════════════════════
     STYLE — semua prefix jw404_ / #jw_404_wrap
     agar 100% tidak konflik dengan style lain
══════════════════════════════════════════ -->
<style>
  #jw_404_wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 60px 16px 80px;
    background: #f8f9fc;
    overflow: hidden;
    text-align: center;
  }

  /* blob */
  .jw404_blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.09;
    pointer-events: none;
    animation: jw_float 9s ease-in-out infinite;
  }
  .jw404_blob_a {
    width: 480px;
    height: 480px;
    background: #0044eb;
    top: -120px;
    right: -80px;
  }
  .jw404_blob_b {
    width: 360px;
    height: 360px;
    background: #f44380;
    bottom: -80px;
    left: -80px;
    animation-delay: -4.5s;
  }
  @keyframes jw_float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-26px);
    }
  }

  /* visual */
  .jw404_visual {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 16px;
    position: relative;
    z-index: 1;
    animation: jw_down 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes jw_down {
    from {
      opacity: 0;
      transform: translateY(-28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .jw404_digit {
    font-family: "Axiforma Bold", sans-serif;
    font-size: clamp(80px, 13vw, 150px);
    line-height: 1;
    letter-spacing: -3px;
    user-select: none;
  }

  .jw404_zero {
    position: relative;
    width: clamp(76px, 11vw, 130px);
    height: clamp(76px, 11vw, 130px);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: jw_pop 0.65s 0.08s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  @keyframes jw_pop {
    from {
      opacity: 0;
      transform: scale(0.3) rotate(-20deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }
  .jw404_zero_bg {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #0044eb;
    box-shadow: 0 14px 44px rgba(0, 68, 235, 0.35);
  }
  .jw404_zero_bg::after {
    content: "";
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.3);
  }
  .jw404_icon {
    position: relative;
    z-index: 1;
    font-size: clamp(24px, 4.5vw, 44px);
    color: #fff;
    animation: jw_pulse 2.5s ease-in-out infinite;
  }
  @keyframes jw_pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.14);
    }
  }

  /* badge */
  .jw404_badge {
    position: relative;
    z-index: 1;
    font-family: "Axiforma Medium", sans-serif;
    font-size: 15px;
    color: #49515b;
    margin-bottom: 12px;
    animation: jw_up 0.6s 0.18s both;
  }

  /* heading */
  .jw404_heading {
    position: relative;
    z-index: 1;
    font-family: "Axiforma Bold", sans-serif;
    font-size: clamp(22px, 3.5vw, 36px);
    color: #020842;
    line-height: 1.28;
    max-width: 580px;
    margin: 0 auto 14px;
    animation: jw_up 0.6s 0.22s both;
  }

  /* desc */
  .jw404_desc {
    position: relative;
    z-index: 1;
    font-size: 15.5px;
    color: #49515b;
    line-height: 1.72;
    max-width: 520px;
    margin: 0 auto 24px;
    animation: jw_up 0.6s 0.26s both;
  }

  @keyframes jw_up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* cta */
  .jw404_cta {
    position: relative;
    z-index: 1;
    margin-bottom: 32px !important;
    animation: jw_up 0.6s 0.3s both;
  }

  /* divider */
  .jw404_divider {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 560px;
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
    animation: jw_up 0.6s 0.34s both;
  }
  .jw404_divider::before,
  .jw404_divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #dde3ef;
  }
  .jw404_divider span {
    font-size: 12.5px;
    color: #9ca3af;
    white-space: nowrap;
    font-family: "Axiforma Medium", sans-serif;
  }

  /* grid */
  .jw404_grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 560px;
    animation: jw_up 0.6s 0.38s both;
  }

  /* card */
  .jw404_card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 15px;
    background: #fff;
    border: 1.5px solid #e5e9f2;
    border-radius: 14px;
    text-decoration: none;
    color: #020842;
    transition:
      border-color 0.22s,
      background 0.22s,
      transform 0.22s,
      box-shadow 0.22s;
  }
  .jw404_card:hover {
    border-color: #0044eb;
    background: #f0f5ff;
    color: #020842;
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(0, 68, 235, 0.1);
    text-decoration: none;
  }
  .jw404_card[data-wa="true"]:hover {
    border-color: #25d366;
    background: #f0fff7;
    box-shadow: 0 8px 22px rgba(37, 211, 102, 0.12);
  }

  .jw404_card_ico {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition:
      background 0.22s,
      color 0.22s;
  }
  .jw404_card:hover .jw404_card_ico {
    background: #0044eb !important;
    color: #fff !important;
  }
  .jw404_card[data-wa="true"]:hover .jw404_card_ico {
    background: #25d366 !important;
    color: #fff !important;
  }

  .jw404_card_txt {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
    text-align: left;
  }
  .jw404_card_txt strong {
    font-family: "Axiforma SemiBold", sans-serif;
    font-size: 13px;
    color: #020842;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .jw404_card_txt small {
    font-size: 11.5px;
    color: #8a94a6;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .jw404_card_arr {
    font-size: 11px;
    color: #c5cbd7;
    min-width: 11px;
    transition:
      color 0.22s,
      transform 0.22s;
  }
  .jw404_card:hover .jw404_card_arr {
    color: #0044eb;
    transform: translateX(3px);
  }
  .jw404_card[data-wa="true"]:hover .jw404_card_arr {
    color: #25d366;
    transform: translateX(3px);
  }

  /* responsive */
  @media (max-width: 575px) {
    #jw_404_wrap {
      padding: 60px 16px 60px;
    }
    .jw404_grid {
      grid-template-columns: 1fr;
    }
    .jw404_digit {
      letter-spacing: -2px;
    }
  }
</style>
