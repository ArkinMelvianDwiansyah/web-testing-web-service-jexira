---
// src/pages/service/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import { services, getServiceBySlug } from '../../data/services';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return services.map(s => ({ params: { slug: s.slug } }));
};

const { slug } = Astro.params;
const service = getServiceBySlug(slug!);

if (!service) return Astro.redirect('/services');
---

<BaseLayout
  title={`${service.title} - JalaninWeb.com`}
  description={service.metaDesc}
>
  <main class="page_content">

    <!-- Page Banner -->
    <section
      class="page_banner_section text-center"
      style="background-image: url('/assets/images/shapes/bg_pattern_4.svg');"
    >
      <div class="container">
        <div class="heading_focus_text text-white">
          Layanan <span class="badge bg-secondary">{service.badge} 😍</span>
        </div>
        <h1 class="page_title mb-0 text-white">{service.title}</h1>
      </div>
    </section>

    <!-- Service Details Section -->
    <section class="service_details_section section_space bg-light">
      <div class="container">

        <!-- Hero Image -->
        <div class="details_item_image position-relative">
          <img
            src={service.heroImage}
            alt={`${service.title} - JalaninWeb`}
            loading="lazy"
          />
        </div>

        <!-- Title & Description -->
        <h2 class="details_item_title">{service.title}</h2>
        <p class="mb-2">{service.tagline}</p>
        <p>{service.description}</p>

        <!-- Service Process -->
        <h3 class="details_item_info_title">Proses Pengerjaan</h3>
        <div class="row mb-5 align-items-center justify-content-lg-between">

          <!-- Accordion -->
          <div class="col-lg-6">
            <div class="accordion" id="service_process_faq">
              {service.process.map((p, i) => (
                <div class="accordion-item">
                  <div
                    class:list={["accordion-button", { collapsed: i !== 0 }]}
                    role="button"
                    data-bs-toggle="collapse"
                    data-bs-target={`#collapse_${i}`}
                    aria-expanded={i === 0 ? "true" : "false"}
                    aria-controls={`collapse_${i}`}
                  >
                    {p.step}. {p.title}
                  </div>
                  <div
                    id={`collapse_${i}`}
                    class:list={["accordion-collapse collapse", { show: i === 0 }]}
                    data-bs-parent="#service_process_faq"
                  >
                    <div class="accordion-body">
                      <p class="m-0">{p.desc}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Layer visual -->
          <div class="col-lg-5">
            <ul class="content_layer_group unordered_list_block text-center">
              {service.process.map((p, i) => (
                <li
                  class:list={["accordion-button", { collapsed: i !== 0 }]}
                  role="button"
                  data-bs-toggle="collapse"
                  data-bs-target={`#collapse_${i}`}
                  aria-expanded={i === 0 ? "true" : "false"}
                  aria-controls={`collapse_${i}`}
                >
                  <span>{p.title}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>

        <!-- Outcomes -->
        <h3 class="details_item_info_title">Apa yang Kamu Dapatkan</h3>
        <p class="mb-4">
          Setiap layanan kami dirancang untuk memberikan hasil nyata yang berdampak langsung pada bisnis Anda:
        </p>
        <div class="row mb-4">
          <div class="col-lg-6">
            <ul class="icon_list unordered_list_block">
              {service.outcomes.slice(0, 3).map(o => (
                <li>
                  <span class="icon_list_icon">
                    <img src="/assets/images/icons/icon_check_3.svg" alt="Check Icon" />
                  </span>
                  <span class="icon_list_text">{o}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="col-lg-6">
            <ul class="icon_list unordered_list_block">
              {service.outcomes.slice(3).map(o => (
                <li>
                  <span class="icon_list_icon">
                    <img src="/assets/images/icons/icon_check_3.svg" alt="Check Icon" />
                  </span>
                  <span class="icon_list_text">{o}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Detail Images -->
        <div class="row">
          {service.detailImages.map((img, i) => (
            <div class="col-lg-4 col-md-6 col-sm-6">
              <div class="details_item_image m-0">
                <img src={img} alt={`${service.title} detail ${i + 1}`} loading="lazy" />
              </div>
            </div>
          ))}
        </div>

        <!-- Nav ke layanan lain -->
        <div class="other_posts_nav mt-5">
          {(() => {
            const idx = services.findIndex(s => s.slug === slug);
            const prev = services[idx - 1];
            const next = services[idx + 1];
            return (
              <>
                {prev ? (
                  <a href={`/service/${prev.slug}`}>
                    <i class="fa-regular fa-arrow-left-long"></i>
                    <span>
                      <strong>{prev.title}</strong>
                      <small>Layanan sebelumnya</small>
                    </span>
                  </a>
                ) : <span></span>}
                {next ? (
                  <a href={`/service/${next.slug}`}>
                    <span>
                      <strong>{next.title}</strong>
                      <small>Layanan berikutnya</small>
                    </span>
                    <i class="fa-regular fa-arrow-right-long"></i>
                  </a>
                ) : <span></span>}
              </>
            );
          })()}
        </div>

      </div>
    </section>

    <CTA />

  </main>
</BaseLayout>